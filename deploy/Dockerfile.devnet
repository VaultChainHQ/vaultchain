# vaultl1 devnet node (single validator, timer blocks). Build from the repo root:
#   docker build -f deploy/Dockerfile.devnet -t vaultl1-devnet .
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/vaultd ./cmd/vaultd

FROM alpine:3.20
# curl is for the entrypoint's readiness checks; su-exec drops root after the
# volume (mounted root-owned) has been chowned.
RUN apk add --no-cache ca-certificates curl su-exec \
 && adduser -D -u 10001 vault \
 && mkdir -p /data && chown vault:vault /data
COPY --from=build /out/vaultd /usr/local/bin/vaultd
COPY deploy/devnet-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh
EXPOSE 1317
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]